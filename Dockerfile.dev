# Development Dockerfile with Node.js 24 (pinned version from .nvmrc)
FROM node:24-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose React development server port
EXPOSE 3000

# Start development server
CMD ["npm", "start"]

